#!/usr/bin/env bash
# Runs the gate's checks (.github/scripts/check.sh) before a push, so a failure
# shows up here instead of in CI. CI still runs on every PR and is still the gate.
#
# Turn it on once per clone:  git config core.hooksPath .githooks
# Skip it for one push:       git push --no-verify
#
# It checks each commit being pushed in a temporary worktree, so uncommitted
# or untracked files don't change the result. If a tool check.sh needs isn't
# installed, it warns and lets the push through.

set -uo pipefail

# Where CONTRIBUTING's install steps put skills-ref.
PATH="$HOME/.venvs/skills-ref/bin:$PATH"
# Git sets these for hooks; they'd point the worktree's git commands at this checkout.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

zero="0000000000000000000000000000000000000000"
base="origin/main"   # what CI compares against; check.sh warns and skips the private check if it's missing
tmp=""
cleanup() { [ -z "$tmp" ] || git worktree remove --force "$tmp" >/dev/null 2>&1; }
trap cleanup EXIT

status=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch: nothing to check
  tmp="$(mktemp -d)"
  rmdir "$tmp"
  git worktree add --detach -q "$tmp" "$local_sha" || { echo "pre-push: couldn't check out $local_ref to check it." >&2; exit 1; }
  echo "pre-push: checking $local_ref ($(git rev-parse --short "$local_sha")) against $base"
  (cd "$tmp" && .github/scripts/check.sh --base "$base") | grep -v '^ok '
  rc="${PIPESTATUS[0]}"
  cleanup; tmp=""
  case "$rc" in
    0) echo "pre-push: all checks passed." ;;
    2) echo "pre-push: skipped, a tool check.sh needs is missing (see above). CI will still check." >&2 ;;
    *) echo "pre-push: checks failed for $local_ref. Fix them, or push with --no-verify and let CI report." >&2; status=1 ;;
  esac
done

exit "$status"
